# Copy to .env and fill in. .env is git-ignored.

# Supabase project holding the sentinel-data bucket (training/sft/*)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-PUBLISHABLE-OR-SERVICE-KEY
SUPABASE_BUCKET=sentinel-data

# API key testers must send as X-API-Key when the server is exposed (serve.sh generates one if empty)
# SENTINEL_API_KEY=

# Optional: Hugging Face token (only needed for gated base models)
# HF_TOKEN=hf_...

# ---- AWS deployment (python scripts/ops.py up) ------------------------------------------------
# Streaming is Amazon Kinesis Data Streams, created by Terraform with the rest of the stack: no extra key needed.
# Models run on Hyperstack (bash hyperstack/serve_all.sh): VM public IP + the API key it prints.
# Open TCP 8000-8002 on the Hyperstack firewall (the AWS Fargate task has no fixed IP; the API key protects them).
# TF_VAR_hyperstack_host=1.2.3.4
# TF_VAR_model_api_key=
# Region for AWS (default ap-south-1 / Mumbai; the project gets its own isolated VPC there)
AWS_REGION=ap-south-1
# Optional
# TF_VAR_alert_email=you@example.com
# GITHUB_REPO=euron-tech/Project-sentinal-gpu-training-of-model
