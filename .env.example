# ============================================================
# .env.example — Copy to .env and fill in real values
# ============================================================

# Supabase connection (REST API)
SUPABASE_API_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_API_KEY=YOUR-ANON-OR-SERVICE-ROLE-KEY

# Supabase PostgreSQL (optional — for raw DB access)
SUPABASE_DB_HOST=db.YOUR-PROJECT.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.YOUR-PROJECT
SUPABASE_DB_PASSWORD=YOUR-PASSWORD
SUPABASE_DB_NAME=postgres

# Data
DATA_FILE=./data/transactions.csv
DATA_OUTPUT_DIR=./data/output

# Model
MODEL_NAME=Qwen/Qwen2.5-0.5B

# Training
OUTPUT_DIR=./output
LOGGING_DIR=./logs

# HuggingFace Hub (optional — for pushing the adapter)
HF_TOKEN=YOUR-HF-TOKEN